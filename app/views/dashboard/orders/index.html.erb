<% content_for :dashboard_stylesheets do %>
  <%= stylesheet_link_tag "dashboard/orders", "data-turbo-track": "reload", as: "style" %>
<% end %>

<div class="dashboard-content">
  <div>

    <span class="dashboard-eyebrow">
      Restaurant Operations
    </span>

    <h1>
      Orders
    </h1>

    <p>
      Manage orders.
    </p>

    <div class="dashboard-header-actions">

      <%= button_to dashboard_orders_path, params: @status_filter_param, method: :get, class: "dashboard-secondary-button", id: "refresh-orders" do %>

        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 11a8 8 0 0 0-14.9-3"></path>
          <path d="M4 4v4h4"></path>
          <path d="M4 13a8 8 0 0 0 14.9 3"></path>
          <path d="M20 20v-4h-4"></path>
        </svg>

        Refresh

      <% end %>

    </div>

  </div>

  <section class="order-filters" aria-label="Order status filters">

    <%= button_to dashboard_orders_path, method: :get, class: class_names("order-filter", active: params[:status].blank?), data: { status: "all" } do %>
      <span>All</span>
      <strong><%= @current_orders_counting.values.sum %></strong>
    <% end %>

    <%= button_to dashboard_orders_path, params: { status: "opened" }, method: :get, class: class_names("order-filter", active: params[:status] == "opened"), data: { status: "opened" } do %>
      <span>Opened</span>
      <strong><%= @current_orders_counting["opened"] || 0 %></strong>
    <% end %>

    <%= button_to dashboard_orders_path, params: { status: "processing" }, method: :get, class: class_names("order-filter", active: params[:status] == "processing"), data: { status: "processing" } do %>
      <span>Processing</span>
      <strong><%= @current_orders_counting["processing"] || 0 %></strong>
    <% end %>

    <%= button_to dashboard_orders_path, params: { status: "packed" }, method: :get, class: class_names("order-filter", active: params[:status] == "packed"), data: { status: "packed" } do %>
      <span>Packed</span>
      <strong><%= @current_orders_counting["packed"] || 0 %></strong>
    <% end %>


    <%= button_to dashboard_orders_path, params: { status: "completed" }, method: :get, class: class_names("order-filter", active: params[:status] == "completed"), data: { status: "completed" } do %>
      <span>Completed</span>
      <strong><%= @current_orders_counting["completed"] || 0 %></strong>
    <% end %>

  </section>

  <% if @orders.any? %>

    <% @orders.each do |order| %>

      <header class="orders-page-header">

        <div>
          <p>
            Sell Order #<%= order.sell_order.id %>
              · <%= order.sell_order.allocation.name.humanize %>
          </p>
        </div>

        <% if order.sell_order.opened? %>

          <div class="orders-page-header-actions">
            <%= link_to "New Order" , new_dashboard_sell_order_order_path(order.sell_order),
              class: "dashboard-primary-button" %>
          </div>

        <% end %>

      </header>

      <section class="orders-index-list">

        <article class="order-card">

          <div class="order-card-main">

            <div class="order-card-header">

              <div>
                <span class="order-card-label">
                  Order
                </span>

                <h2>
                  #<%= order.id %>
                </h2>
              </div>

              <span class="order-status order-status--<%= order.status.dasherize %>">
                <%= order.status.humanize %>
              </span>

            </div>

            <div class="order-card-summary">

              <div>
                <span class="order-card-meta-label">
                  Products
                </span>

                <strong>
                  <%= order.order_products.sum(&:quantity) %>
                </strong>
              </div>

              <div>
                <span class="order-card-meta-label">
                  Lines
                </span>

                <strong>
                  <%= order.order_products.size %>
                </strong>
              </div>

              <div>
                <span class="order-card-meta-label">
                  Created
                </span>

                <strong>
                  <%= order.created_at.strftime("%I:%M %p") %>
                </strong>
              </div>

            </div>


            <div class="order-card-products">

              <% order.order_products.each do |order_product| %>

                <div class="order-card-product">

                  <span class="order-card-product-quantity">
                    <%= order_product.quantity %>×
                  </span>

                  <span class="order-card-product-name">
                    <%= order_product.product.name.humanize %>
                  </span>

                  <% if order_product.note.present? %>
                    <span class="order-card-product-note">
                      <%= order_product.note %>
                    </span>
                  <% end %>

                </div>

              <% end %>

            </div>

          </div>

          <div class="order-card-actions">

            <%= link_to "View Order", dashboard_order_path(order), class: "dashboard-secondary-button" %>

            <% if order.status=="opened" %>

              <%= link_to "Edit", edit_dashboard_order_path(order), class: "dashboard-secondary-button" %>

            <% end %>

          </div>

        </article>

      </section>

    <% end %>

  <% else %>

    <div class="dashboard-empty-state">

      <div class="dashboard-empty-state-icon">
        +
      </div>

      <h2>No orders yet</h2>

      <p>
        Create an order to start adding products for this sell order.
      </p>

    </div>

  <% end %>

</div>
