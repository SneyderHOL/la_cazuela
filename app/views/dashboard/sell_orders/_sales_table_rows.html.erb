<% current_sales.each do |sale| %>
  <tr>

    <td>

      <div class="sell-order-number">
        #<%= sale.id %>
      </div>

      <span class="sell-order-date">
        <%= sale.created_at.strftime("%A, %I:%M %p") %>
      </span>

    </td>


    <td>

      <span class="allocation-name">
        <%= sale.allocation.name %>
      </span>

    </td>


    <%= render 'dashboard/sell_orders/counts_table_data', sell_order_counts: sell_orders_counting_helper(sale) %>


    <td>

      <span class="payment-<%= sale.payment_type.blank? ? 'not-' : '' %>selected">
        <%= sale.payment_type || "Not selected" %>
      </span>

    </td>


    <td>

      <span class="sell-order-status <%= sale.status.dasherize %>">
        <%= sale.status.humanize %>
      </span>

    </td>


    <td>

      <%= link_to "View", dashboard_sell_order_path(sale.id), class: "sell-order-view-button" %>

    </td>

  </tr>

<% end %>
