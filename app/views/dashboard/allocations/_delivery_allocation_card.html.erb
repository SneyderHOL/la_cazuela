<!-- Delivery card -->
<article class="delivery-allocation-card">

  <div class="delivery-allocation-main">

    <div class="delivery-allocation-icon">

      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 7h11v10H3z"></path>
        <path d="M14 10h4l3 3v4h-7z"></path>
        <circle cx="7" cy="19" r="2"></circle>
        <circle cx="18" cy="19" r="2"></circle>
      </svg>

    </div>


    <div class="delivery-allocation-element">

      <div class="delivery-allocation-title">

        <h3>
          <%= link_to dashboard_allocation_path(delivery.id) do %>
            <%= delivery.name.humanize %>
          <% end %>
        </h3>

        <span class="allocation-status busy">
          Pending Orders
        </span>

      </div>

      <div class="delivery-allocation-suborders">

        <% @deliveries[delivery.id].each do |sell_order| %>

          <div class="delivery-allocation-details">
            <p>
              Sell Order #<%= sell_order.id %>
            </p>

            <div class="delivery-allocation-suborder-links">

              <% sell_order.orders.each do |order| %>

                <%= link_to dashboard_order_path(order.id), class: "dashboard-secondary-button" do %>
                  View Order #<%= order.id %>

                  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14"></path>
                    <path d="M13 6l6 6-6 6"></path>
                  </svg>

                <% end %>

              <% end %>

            </div>

          </div>

        <% end %>

      </div>

    </div>

  </div>

</article>
