<header class="header" data-controller="header" data-action="scroll@window->header#scroll">

  <div class="container navbar">

    <%= link_to root_path, class: "logo" do %>

      <%= image_tag "la_cazuela_logo.jpg", alt: "logo", class: "header-logo" %>

    <% end %>

    <nav class="desktop-nav">

      <ul>

        <li>
          <%= link_to "Menu", menu_path %>
        </li>

        <li>
          <%= link_to "Location", location_path %>
        </li>

        <li>
          <%= link_to "About", about_path %>
        </li>

        <li>
          <%= link_to "Contact", contact_path %>
        </li>

        <li>
          <% if signed_in? %>
            <div class="user_name_email" id="user_name_email">
              <%= "#{current_user.nickname ? current_user.nickname : current_user.email}" %>
            </div>
            <%= button_to "Sign Out", "session_path", method: :delete, class: "staff-login" %>
          <% else %>
            <%= link_to "Staff Login", "signin_path", class: "staff-login" %>
          <% end %>
        </li>

      </ul>


    </nav>

    <div class="mobile-actions">
    
      <button class="hamburger" id="hamburgerBtn" aria-label="Open Menu" data-controller="hamburguer" data-action="click->hamburguer#click">
          <span></span>
          <span></span>
          <span></span>
      </button>

    </div>

  </div>

  <div class="mobile-menu" id="mobileMenu">

    <%= link_to "Menu", menu_path %>

    <%= link_to "Location", location_path %>

    <%= link_to "About", about_path %>

    <%= link_to "Contact", contact_path %>

    <% if signed_in? %>
      <div class="user_name_email" id="user_name_email">
        <%= "#{current_user.nickname ? current_user.nickname : current_user.email}" %>
      </div>
      <%= button_to "Sign Out", "session_path", method: :delete, class: "staff-login" %>
    <% else %>
      <%= link_to "Staff Login", "signin_path", class: "staff-login" %>
    <% end %>

  <div>
  
</header>
