<!-- =========================================
      SIDEBAR
========================================== -->

<aside class="dashboard-sidebar" id="dashboardSidebar">

  <div class="sidebar-brand">

    <%= link_to dashboard_path, class: "logo" do %>
      <%= image_tag "la_cazuela_logo.jpg", alt: "logo", class: "sidebar-logo" %>

      <div class="sidebar-brand-text">

        <strong>La Cazuela</strong>

        <span>Staff</span>

      </div>

    <% end %>

  </div>


  <!-- Navigation -->

  <nav class="dashboard-navigation">

    <span class="navigation-label">
      Operations
    </span>

    <%= link_to dashboard_path, class: class_names("dashboard-nav-link", active: current_page?(dashboard_path)) do %>
      <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" >
        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
        <rect x="14" y="14" width="7" height="7" rx="1"></rect>
      </svg>
      <span>Dashboard</span>
    <% end %>

    <%= link_to dashboard_allocations_path, class: class_names("dashboard-nav-link", active: current_page?(dashboard_allocations_path)) do %>
      <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" >
        <rect x="3" y="4" width="18" height="7" rx="1" ></rect>
        <path d="M6 11v8"></path>
        <path d="M18 11v8"></path>
        <path d="M3 8h18"></path>
      </svg>
      <span>Allocations</span>
    <% end %>

    <%= link_to dashboard_orders_path, class: class_names("dashboard-nav-link", active: current_page?(dashboard_orders_path)) do %>
      <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" >
        <path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3z" ></path>
        <path d="M9 7h6"></path> <path d="M9 11h6"></path>
        <path d="M9 15h3"></path>
      </svg>
      <span>Orders</span>
    <% end %>

    <%= link_to dashboard_sell_orders_path, class: class_names("dashboard-nav-link", active: current_page?(dashboard_sell_orders_path)) do %>
      <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2v20"></path>
        <path d="M17 6.5c0-1.7-2.2-3-5-3s-5 1.3-5 3 2.2 3 5 3 5 1.3 5 3-2.2 3-5 3-5-1.3-5-3"></path>
      </svg>
      <span>Sell Orders</span>
    <% end %>

    <%= link_to dashboard_preparations_path, class: class_names("dashboard-nav-link", active: current_page?(dashboard_preparations_path)) do %>
      <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" >
        <path d="M6 10h12"></path>
        <path d="M7 10a4 4 0 0 1 0-8 4 4 0 0 1 3.5 2 4 4 0 0 1 7.5 2 4 4 0 0 1-1 8" ></path>
        <path d="M7 10v8"></path>
        <path d="M17 10v8"></path>
        <path d="M7 18h10"></path>
        <path d="M9 22h6"></path>
      </svg>
      <span>Preparations</span>
    <% end %>

  </nav>


  <!-- Sidebar Footer -->

  <div class="sidebar-footer">

    <%= button_to destroy_user_session_path, method: :delete, class: "dashboard-nav-link logout-link", data: {
        turbo_confirm: "Want to sign out?" } do %>

      <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" >
        <path d="M10 17l5-5-5-5"></path>
        <path d="M15 12H3"></path>
        <path d="M21 3v18"></path>
      </svg>

      <span>Sign Out</span>

    <% end %>

  </div>

</aside>