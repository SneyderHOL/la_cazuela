<% content_for :page_stylesheets do %>
  <%= stylesheet_link_tag "pages/about", "data-turbo-track": "reload" %>
<% end %>

<!-- ABOUT HERO -->

<section class="about-hero">

  <div class="hero-overlay">

    <div class="container">

      <h1>Our Story</h1>

      <p>

        Fresh seafood, authentic recipes,
        and unforgettable dining experiences.

      </p>

    </div>

  </div>

</section>

<section class="story">

  <div class="container story-grid">

    <div>

      <img
        src="https://images.unsplash.com/photo-1577219491135-ce391730fb2c"
        alt="Chef preparing seafood">

    </div>

    <div>

      <h2>Inspired by the Coast</h2>

      <p>

        At La Cazuela, every meal begins with
        the freshest seafood delivered daily.

        Inspired by coastal traditions and
        prepared with authentic recipes,
        our mission is to bring the flavors
        of the ocean to Orlando.

        Whether you're enjoying a family dinner,
        celebrating a special occasion,
        or simply craving fresh seafood,
        we welcome you like family.

      </p>

    </div>

  </div>

</section>

<section class="values">

  <div class="container">

    <h2>What We Believe</h2>

    <div class="values-grid">

      <div class="value-card">

        🐟

        <h3>Fresh Ingredients</h3>

        <p>

          We source seafood daily to ensure
          quality in every dish.

        </p>

      </div>

      <div class="value-card">

        ❤️

        <h3>Hospitality</h3>

        <p>

          Every guest is treated like family
          from the moment they arrive.

        </p>

      </div>

      <div class="value-card">

        🌊

        <h3>Authentic Recipes</h3>

        <p>

          Traditional coastal recipes crafted
          with passion.

        </p>

      </div>

    </div>

  </div>

</section>

<section class="why-us">

  <div class="container">

    <h2>Why Guests Love La Cazuela</h2>

    <ul>

      <li>✔ Fresh seafood delivered daily</li>

      <li>✔ Family-friendly atmosphere</li>

      <li>✔ Authentic coastal recipes</li>

      <li>✔ Convenient International Drive location</li>

      <li>✔ Friendly service every visit</li>

    </ul>

  </div>

</section>

<section class="process">

  <div class="container">

    <h2>From Dock to Table</h2>

    <div class="timeline">

      <div class="step">

        <span>1</span>

        <h3>Fresh Catch</h3>

        <p>

          Seafood is selected daily
          from trusted suppliers.

        </p>

      </div>

      <div class="step">

        <span>2</span>

        <h3>Prepared Fresh</h3>

        <p>

          Every dish is cooked
          to order by our chefs.

        </p>

      </div>

      <div class="step">

        <span>3</span>

        <h3>Served With Care</h3>

        <p>

          Enjoy authentic flavors
          at your table.

        </p>

      </div>

    </div>

  </div>

</section>

<section class="gallery">

  <div class="container">

    <h2>Inside La Cazuela</h2>

    <div class="gallery-grid">

      <img src="https://plus.unsplash.com/premium_photo-1661892402083-4a4a0adcc44a">

      <img src="https://images.unsplash.com/photo-1582629694540-2c43904a9b09">

      <img src="https://images.unsplash.com/photo-1636647511729-6703539ba71f">

      <img src="https://images.unsplash.com/photo-1606850780554-b55ea4dd0b70">

    </div>

  </div>

</section>

<section class="about-cta">

  <div class="container">

    <h2>

      Experience Fresh Seafood Today

    </h2>

    <p>

      Visit us and discover why
      locals and visitors love La Cazuela.

    </p>

    <a href="https://maps.google.com/?q=4951+International+Dr+Orlando+FL+32819" class="btn-primary" target="_blank">

      Get Directions

    </a>

  </div>

</section>
