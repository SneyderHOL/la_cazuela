<% content_for :page_stylesheets do %>
  <%= stylesheet_link_tag "pages/contact", "data-turbo-track": "reload" %>
<% end %>

<!-- HERO -->

<section class="contact-hero">

  <div class="hero-overlay">

    <div class="container">

      <h1>Get In Touch</h1>

      <p>

        Have a question?
        We're here to help.

      </p>

    </div>

  </div>

</section>

<section class="contact-info">

  <div class="container info-grid">

    <div class="info-card">

      <h3>📍 Visit Us</h3>

      <p>

        4951 International Dr

        Orlando, FL 32819

      </p>

    </div>

    <div class="info-card">

      <h3>📞 Call Us</h3>

      <p>

        (407) 555-1234

      </p>

    </div>

    <div class="info-card">

      <h3>✉️ Email</h3>

      <p>

        hello@lacazuela.com

      </p>

    </div>

    <div class="info-card">

      <h3>🕒 Hours</h3>

      <p>

        Mon–Fri

        11 AM – 8 PM

      </p>

      <p>

        Sat–Sun

        11 AM – 5 PM

      </p>

    </div>

  </div>

</section>

<section class="contact-form-section">

  <div class="container form-grid">

    <div>

      <h2>Send Us a Message</h2>

      <p>

        We'll get back to you as soon as possible.

      </p>

    </div>

    <form class="contact-form">

      <input type="text" placeholder="Your Name" required>

      <input type="email" placeholder="Email Address" required>

      <input type="tel" placeholder="Phone Number">

      <textarea placeholder="How can we help?" rows="6" required>

                </textarea>

      <button type="submit" class="btn-primary">

        Send Message

      </button>

    </form>

  </div>

</section>

<section class="contact-cta">

  <div class="container">

    <h2>

      Ready for Fresh Seafood?

    </h2>

    <p>

      Visit us today or get directions
      to La Cazuela.

    </p>

    <a class="btn-primary" href="https://maps.google.com/?q=4951+International+Dr+Orlando+FL+32819" target="_blank">

      Get Directions

    </a>

  </div>

</section>
