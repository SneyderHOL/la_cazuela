<% content_for :page_stylesheets do %>
  <%= stylesheet_link_tag "pages/location", "data-turbo-track": "reload" %>
<% end %>

<!-- LOCATION HERO -->

<section class="location-hero">

  <div class="hero-overlay">

    <div class="container">

      <h1>Visit La Cazuela</h1>

      <p>
        Fresh seafood awaits just minutes from Orlando's
        most popular attractions.
      </p>

    </div>

  </div>

</section>

<section class="location-info">

  <div class="container info-grid">

    <div class="info-card">

      <h3>Address</h3>

      <p>
        4951 International Dr<br>
        Orlando, FL 32819
      </p>

    </div>

    <div class="info-card">

      <h3>Hours</h3>

      <p>

        Mon–Fri<br>

        11:00 AM – 8:00 PM

      </p>

      <p>

        Sat–Sun<br>

        11:00 AM – 5:00 PM

      </p>

    </div>

    <div class="info-card">

      <h3>Phone</h3>

      <p>(407) 555-1234</p>

    </div>

  </div>

</section>

<section class="map-section">

  <div class="container">

    <h2>Find Us</h2>

    <div class="map-wrapper">

      <iframe src="https://www.google.com/maps?q=4951+International+Dr+Orlando+FL+32819&output=embed" loading="lazy"
        allowfullscreen>

      </iframe>

    </div>

  </div>

</section>

<section class="directions">

  <div class="container">

    <h2>Getting Here</h2>

    <div class="directions-grid">

      <div>

        <h3>Driving</h3>

        <p>

          Conveniently located on International Drive,
          minutes from Universal Orlando Resort and
          easy to reach from I-4.

        </p>

      </div>

      <div>

        <h3>Parking</h3>

        <p>

          Free customer parking is available
          directly in front of the restaurant.

        </p>

      </div>

    </div>

  </div>

</section>

<section class="hours">

  <div class="container">

    <h2>Business Hours</h2>

    <table>

      <tr>

        <td>Monday–Friday</td>

        <td>11:00 AM – 8:00 PM</td>

      </tr>

      <tr>

        <td>Saturday–Sunday</td>

        <td>11:00 AM – 5:00 PM</td>

      </tr>

    </table>

  </div>

</section>

<section class="nearby">

  <div class="container">

    <h2>Nearby Attractions</h2>

    <div class="nearby-grid">

      <div class="near-card">

        🎢

        <h3>Universal Orlando Resort</h3>

        <p>Just a few minutes away.</p>

      </div>

      <div class="near-card">

        🛍️

        <h3>Orlando International Premium Outlets</h3>

        <p>Perfect before or after shopping.</p>

      </div>

      <div class="near-card">

        🎡

        <h3>ICON Park</h3>

        <p>Only a short drive away.</p>

      </div>

    </div>

  </div>

</section>

<section class="location-cta">

  <div class="container">

    <h2>Ready for Fresh Seafood?</h2>

    <p>

      We're looking forward to serving you.

    </p>

    <a class="btn-primary" target="_blank" href="https://maps.google.com/?q=4951+International+Dr+Orlando+FL+32819">

      Get Directions

    </a>

  </div>

</section>